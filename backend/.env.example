# PostgreSQL
POSTGRES_USER=qrdining
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=qrdining
DATABASE_URL=postgres://qrdining:changeme_strong_password@postgres:5432/qrdining

# Redis
REDIS_URL=redis://redis:6379/0

# Server
PORT=8080
GIN_MODE=release
SHUTDOWN_TIMEOUT=15s
READ_TIMEOUT=10s
WRITE_TIMEOUT=30s

# Logging
LOG_LEVEL=info
LOG_PRETTY=false

# CORS — comma-separated origins for PWA and staff dashboard
CORS_ALLOWED_ORIGINS=https://qr.yourdomain.com,https://staff.yourdomain.com

# Rate limiting
RATE_LIMIT_RPM=60

# Background workers
STALE_SESSION_INTERVAL=5m
PRESENCE_EXPIRY_INTERVAL=60s

# Trusted proxies — comma-separated CIDRs of nginx container network
TRUSTED_PROXIES=172.16.0.0/12
