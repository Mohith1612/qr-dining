# PostgreSQL
POSTGRES_USER=qrdining
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=qrdining
DATABASE_URL=postgres://qrdining:changeme_strong_password@postgres:5432/qrdining

# Redis
REDIS_URL=redis://redis:6379/0

# Server
PORT=8080
GIN_MODE=release
SHUTDOWN_TIMEOUT=15s
READ_TIMEOUT=10s
WRITE_TIMEOUT=30s

# Logging
LOG_LEVEL=info
LOG_PRETTY=false

# CORS — comma-separated origins for PWA and staff dashboard.
# REQUIRED in release mode: an empty list makes the app refuse to start
# (an empty list would otherwise accept all WebSocket origins).
CORS_ALLOWED_ORIGINS=https://qr.yourdomain.com,https://staff.yourdomain.com

# Secrets — REQUIRED in release mode (the app refuses to start on the dev default
# or on a value shorter than 32 chars). Generate with: openssl rand -hex 32
GUEST_TOKEN_SECRET=
GUEST_TOKEN_TTL=2h

# MFA encryption key — AES-GCM key for platform TOTP secrets at rest.
# Optional (platform MFA fails closed if unset), but if set it must be >= 16 chars.
MFA_ENCRYPTION_KEY=

# Payment provider webhook secrets — one per provider, e.g.
# PAYMENT_WEBHOOK_SECRET_RAZORPAY=... — when set in release mode each must be >= 16 chars.
# PAYMENT_WEBHOOK_SECRET_RAZORPAY=

# Rate limiting
RATE_LIMIT_RPM=60

# Background workers
STALE_SESSION_INTERVAL=5m
PRESENCE_EXPIRY_INTERVAL=60s
HOST_ABSENCE_GRACE=3m
SESSION_PRESENCE_GRACE=60s
SESSION_IDLE_GRACE=5m
SESSION_REACTIVATION_WINDOW=5m

# Trusted proxies — comma-separated CIDRs of nginx container network
TRUSTED_PROXIES=172.16.0.0/12
