# qr-dining frontend — production build environment (Cloudflare deployment).
#
# These are BUILD-TIME values (inlined by Next.js). The prebuild guard
# (scripts/check-prod-env.mjs) fails the build if API/WS URLs are missing,
# localhost, or plain http/ws — so the real domain must exist before a real
# production build. CHANGEME-DOMAIN.com is the placeholder until purchase.
#
# Copy to .env.production (gitignored) — or set these as build variables in the
# Cloudflare project — and replace every CHANGEME.

# Backend API + WebSocket origins (the VM's nginx vhost).
NEXT_PUBLIC_API_URL=https://api.CHANGEME-DOMAIN.com
NEXT_PUBLIC_WS_URL=wss://api.CHANGEME-DOMAIN.com

# CSP connect-src host — MUST match NEXT_PUBLIC_API_URL's origin, or the
# browser blocks API/WS calls under the production Content-Security-Policy.
NEXT_PUBLIC_API_BASE=https://api.CHANGEME-DOMAIN.com

NEXT_PUBLIC_ENV=production

# R2 public base for menu/collateral images (CSP img-src). Set to the uploads
# bucket's public base URL; leave unset if uploads are not in use yet.
# NEXT_PUBLIC_R2_PUBLIC_BASE=https://__REPLACE_WITH_R2_PUBLIC_BASE__

# Subdomain tenancy (only with wildcard DNS + BASE_DOMAIN set on the backend):
# NEXT_PUBLIC_BASE_DOMAIN=CHANGEME-DOMAIN.com

# Public guest origin used in generated QR payloads (defaults to browser origin):
# NEXT_PUBLIC_GUEST_URL=https://app.CHANGEME-DOMAIN.com
