# /etc/qr-dining/backup.env — environment for the nightly backup.
# Install root-only:  sudo install -m 600 backup.env.example /etc/qr-dining/backup.env
# then edit the values.
#
# NOTE: this is the BACKUPS credential set (private bucket). It is deliberately
# separate from the app's uploads credentials in /opt/qr-dining/.env, and the
# variable names differ (R2_ACCESS_KEY here vs R2_ACCESS_KEY_ID there) — do not
# share tokens between the two. Bucket names are TEMPORARY and env-driven only;
# when the final bucket is created, changing R2_BUCKET here is the only edit.

# Database to back up (the production DB). The job runs on the VM host, outside
# the compose network — reach Postgres via the container:
#   docker exec-based dumps are NOT used; expose is not published, so use the
#   container IP on qr-dining_internal, or simplest: the DSN below with
#   host qr_dining_postgres works when this env is used from a container, and
#   from the host use: postgres://qrdining:<pw>@$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' qr_dining_postgres):5432/qrdining
#   (docs/DEPLOYMENT.md documents the recommended host-side invocation.)
DATABASE_URL=postgres://qrdining:__REPLACE__@__POSTGRES_HOST__:5432/qrdining

# --- Storage provider: r2 (default) | s3 | local ---
BACKUP_PROVIDER=r2

# Cloudflare R2 (S3-compatible). Token scope: Object Read & Write on the
# backups bucket only.
R2_ENDPOINT=https://__REPLACE_WITH_CF_ACCOUNT_ID__.r2.cloudflarestorage.com
R2_BUCKET=qr-dining-backups          # TEMPORARY bucket name
R2_ACCESS_KEY=__REPLACE__
R2_SECRET_KEY=__REPLACE__

# --- AWS S3 (uncomment to use instead; set BACKUP_PROVIDER=s3) ---
# S3_BUCKET=__REPLACE__
# AWS_ACCESS_KEY_ID=__REPLACE__
# AWS_SECRET_ACCESS_KEY=__REPLACE__
# AWS_REGION=ap-south-1
# S3_ENDPOINT_URL=        # only for non-AWS S3-compatible stores

# Retention: delete backups older than this many days (local + remote).
RETENTION_DAYS=14

# Key prefix in the bucket.
BACKUP_PREFIX=backups

# Where the backup writes its success/failure .prom metrics for node_exporter.
# Must be the host path of the observability stack's backup_textfile volume:
#   docker volume inspect qr-dining_backup_textfile --format '{{.Mountpoint}}'
NODE_EXPORTER_TEXTFILE_DIR=__REPLACE_WITH_VOLUME_MOUNTPOINT__
