[Unit]
Description=qr-dining nightly PostgreSQL backup to object storage
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Environment with DATABASE_URL + provider creds. Keep this file root-only (chmod 600).
EnvironmentFile=/etc/qr-dining/backup.env
ExecStart=/opt/qr-dining/backend/scripts/nightly-backup.sh
# A non-zero exit is surfaced to the journal (journalctl -u qr-dining-backup).
#
# It is NOT surfaced via node_exporter's systemd collector: node_exporter runs with
# --collector.textfile.directory only, and no systemd collector is enabled anywhere
# in deploy/observability/. BackupFailed watches the textfile metric
# qr_dining_backup_last_run_status that the script writes itself. (An earlier
# version of this comment claimed the systemd collector was the path.)
#
# The script installs an EXIT trap before validating DATABASE_URL, so a started job
# reports guard failures as well as command failures. A job that never starts is
# detected only by the last-success age alerts; see docs/OPERATIONS.md.
Nice=10
