# /opt/qr-dining/deploy.env — optional overrides for deploy/vm/deploy.sh.
#
# Every value below is the built-in default. The file does not need to exist;
# copy it only to change something. It is sourced by both deploy.sh and
# deploy-approve.sh, so keep it to plain assignments.
#
# NO SECRETS LIVE HERE. The deploy path deliberately has none: the repository is
# public, the GHCR package is public, and the Telegram bot token is read at send
# time from the file Alertmanager already uses. Adding a credential to this file
# would give the deploy path its first thing worth stealing.

# QRD_PROJECT_DIR=/opt/qr-dining
# QRD_REPO_DIR=/opt/qr-dining/repo
# QRD_STATE_DIR=/opt/qr-dining/deploy-state
# QRD_ENV_FILE=/opt/qr-dining/.env
# QRD_COMPOSE_PROJECT=qr-dining

# QRD_GH_REPO=Mohith1612/qr-dining
# QRD_GH_BRANCH=main
# QRD_IMAGE_REPO=ghcr.io/mohith1612/qr-dining

# QRD_PG_CONTAINER=qr_dining_postgres
# QRD_INTERNAL_NET=qr-dining_qr-dining_internal
# QRD_NGINX_CONTAINER=proxy_nginx

# How long an instance has to answer /readyz with a ready body after being
# recreated, and how often to ask. The container's own start_period is 20s and
# migrations run before the HTTP listener binds, so this must stay comfortably
# above "boot + migrate". 120s has ~4x headroom over the measured ~8s boot.
# QRD_HEALTH_TIMEOUT=120
# QRD_HEALTH_INTERVAL=3

# Shares Alertmanager's bot so deploy reports land in the same chat as pages.
# QRD_TELEGRAM_TOKEN_FILE=/opt/qr-dining/secrets/alertmanager/telegram_token
# QRD_TELEGRAM_CHAT_ID=5488346548
