# qr-dining — production environment for the VM.
# Install as /opt/qr-dining/.env, root/appuser-only:
#   install -m 600 .env.production.example /opt/qr-dining/.env   # then edit
#
# This one file serves both docker-compose interpolation (POSTGRES_*, IMAGE_TAG)
# and the app container (env_file). The app validates hard in GIN_MODE=release:
# it will REFUSE TO BOOT on a missing/weak GUEST_TOKEN_SECRET or empty
# CORS_ALLOWED_ORIGINS — there are no insecure fallbacks in release mode.
#
# Every __GENERATE__ value:  openssl rand -base64 48
# Every CHANGEME-DOMAIN.com: replace when the real domain is purchased.
# Bucket names are TEMPORARY and env-driven — never hardcode them elsewhere.

# ══════════════════════════════════════════════════════════════════════════
# ① IMAGE (VM deployment convention — pin to a version tag for real deploys)
# ══════════════════════════════════════════════════════════════════════════
IMAGE_TAG=latest

# ══════════════════════════════════════════════════════════════════════════
# ② REQUIRED SECRETS — the app fails hard without these
# ══════════════════════════════════════════════════════════════════════════
# Postgres container credentials (compose interpolation). Keep the password
# IDENTICAL to the one inside DATABASE_URL below — they describe the same DB.
POSTGRES_USER=qrdining
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_DB=qrdining

# In-container DSNs — hosts are the compose service names, never localhost.
DATABASE_URL=postgres://qrdining:__GENERATE__@postgres:5432/qrdining
REDIS_URL=redis://redis:6379/0

# HMAC secret for guest session tokens. Release mode requires ≥32 chars and
# rejects the dev default.
GUEST_TOKEN_SECRET=__GENERATE__

# AES-GCM key for platform TOTP secrets. Platform logins require MFA; leaving
# this unset makes platform MFA fail closed (no platform console access).
MFA_ENCRYPTION_KEY=__GENERATE__

# Exact allowed origins (guest/staff/platform surfaces + the Cloudflare-hosted
# frontend). Release mode refuses an empty list; this also feeds the WS origin
# allowlist.
CORS_ALLOWED_ORIGINS=https://app.CHANGEME-DOMAIN.com

# ══════════════════════════════════════════════════════════════════════════
# ③ ROLLOUT FLAGS — all nine, explicit. R4–R6 are enforced for launch because
#    the only client already speaks the strong protocols. Never weaken them in
#    production except as a time-bounded rollback while actively supervised.
# ══════════════════════════════════════════════════════════════════════════
AUDIT_LOG_V2_ENABLED=true            # R1 — LIVE since 2026-05-25. Must stay true.
TENANCY_ORGANIZATIONS_ENABLED=false  # R2 — after org backfill + soak
AUTHZ_CENTRAL_POLICY_ENFORCE=false   # R3 — pair; after 48h zero-mismatch shadow
STRICT_BRANCH_SCOPED_MUTATIONS=false # R3 — pair with the line above
AUTH_STAFF_CODE_REQUIRED=true        # R4 — blocks client-selected PIN-only downgrade
AUTH_STAFF_SESSION_DB_REQUIRED=true  # R4 — server-side staff session enforcement
WS_TICKET_AUTH_REQUIRED=true         # R5 — all WS connections require one-time tickets
AUTH_GUEST_CREDENTIALS_REQUIRED=true # R6 — signed guest identity on read/write routes
PAYMENT_STAFF_SETTLEMENT_REQUIRED=false # R7 — needs webhook-replay CI proof

# ══════════════════════════════════════════════════════════════════════════
# ④ CLOUDFLARE R2 — app image uploads (menu/collateral). All five must be set
#    or upload endpoints return 503. This is the UPLOADS credential set; the
#    backup job uses a SEPARATE token with different variable names
#    (deploy/backup/backup.env.example) — do not share credentials.
# ══════════════════════════════════════════════════════════════════════════
R2_ACCOUNT_ID=__REPLACE_WITH_CF_ACCOUNT_ID__
R2_ACCESS_KEY_ID=__REPLACE__
R2_SECRET_ACCESS_KEY=__REPLACE__
R2_BUCKET=qr-dining-uploads          # TEMPORARY bucket name — env-driven only
R2_PUBLIC_BASE=__REPLACE_WITH_R2_PUBLIC_BASE_URL__

# ══════════════════════════════════════════════════════════════════════════
# ⑤ EDGE / OBSERVABILITY / TUNING
# ══════════════════════════════════════════════════════════════════════════
GIN_MODE=release
# CIDR of the docker "proxy" network (X-Forwarded-For trust). Check with:
#   docker network inspect proxy --format '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
TRUSTED_PROXIES=172.16.0.0/12
ENABLE_HSTS=true
LOG_LEVEL=info
LOG_PRETTY=false
PORT=8080
READ_TIMEOUT=10s
WRITE_TIMEOUT=30s
SHUTDOWN_TIMEOUT=15s
RATE_LIMIT_RPM=60
AUTH_RATE_LIMIT_RPM=10
DB_MAX_CONNS=20
DB_MIN_CONNS=2

# OpenTelemetry tracing is dark by default. See deploy/signoz/README.md.
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=signoz-otel-collector:4317
# OTEL_SERVICE_NAME=qr-dining-backend
# OTEL_TRACES_SAMPLE_RATIO=0.1

# ══════════════════════════════════════════════════════════════════════════
# ⑥ OPTIONAL — uncomment when the feature is actually in use
# ══════════════════════════════════════════════════════════════════════════
# Subdomain-based tenant resolution (needs wildcard DNS + cert):
# BASE_DOMAIN=CHANGEME-DOMAIN.com

# Digital-payment webhook secret, one per provider (≥16 chars in release).
# Pilot settles cash/UPI manually — set only when a real gateway is integrated:
# PAYMENT_WEBHOOK_SECRET_RAZORPAY=__GENERATE__
# PAYMENT_WEBHOOK_TIMESTAMP_TOLERANCE=5m

# Worker/lifecycle tuning (defaults were tuned after the dress rehearsal):
# STALE_SESSION_INTERVAL=5m
# SESSION_RECONCILE_INTERVAL=5m
# SESSION_PRESENCE_GRACE=60s
# SESSION_REACTIVATION_WINDOW=5m
# PAYMENT_PENDING_ESCALATION_INTERVAL=1m
# PAYMENT_PENDING_WARN_AFTER=5m
# PAYMENT_PENDING_CRITICAL_AFTER=15m
GUEST_TOKEN_TTL=12h
# AUTH_STAFF_COOKIE_ENABLED=false
