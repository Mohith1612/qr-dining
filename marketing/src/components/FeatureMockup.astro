---
const { type = "menu" } = Astro.props;
---
<div class:list={["feature-mockup", type]}>
  <div class="mock-top"><span class="mono">QR DINING</span><span><i></i> Live</span></div>
  {type === "menu" && <div class="mock-body menu-body"><aside><b>Saffron House</b><small>Table 06</small><span>Popular</span><span>Starters</span><span>Mains</span><span>Desserts</span></aside><main><p class="mini-eyebrow">Good evening, Priya</p><h3>What would the table like?</h3><div class="search">Search the menu</div><div class="mock-food-grid"><article><i></i><b>Paneer tikka</b><small>₹320</small></article><article><i></i><b>Dal makhani</b><small>₹280</small></article></div><div class="mock-cart">4 items in the shared cart <b>₹1,240 →</b></div></main></div>}
  {type === "tracking" && <div class="mock-body track-body"><h3>Your order</h3><p>Table 06 · Confirmed at 7:38 PM</p><div class="timeline"><article class="done"><i></i><span><b>Order confirmed</b><small>The kitchen has your order</small></span></article><article class="active"><i></i><span><b>Preparing</b><small>3 items at the pass</small></span></article><article><i></i><span><b>Ready to serve</b><small>We'll let you know</small></span></article><article><i></i><span><b>Served</b><small>Enjoy your meal</small></span></article></div><div class="assist-row"><button>Call a waiter</button><button>Ask for the bill</button></div></div>}
  {type === "waiter" && <div class="mock-body ops-body"><aside><b>Floor</b><span class="active">Live tables</span><span>Ready to serve</span><span>Assistance</span><span>Settlement</span></aside><main><div class="ops-title"><div><small>SAFFRON HOUSE</small><h3>Good evening, Nikhil</h3></div><b>12 live tables</b></div><div class="floor-grid"><article><small>TABLE 03</small><b>Bill requested</b><span>₹1,840 · UPI</span></article><article class="ready"><small>TABLE 06</small><b>Ready to serve</b><span>4 items · 1 min</span></article><article><small>TABLE 08</small><b>Needs assistance</b><span>Called 2 min ago</span></article><article class="quiet"><small>TABLE 11</small><b>Dining</b><span>Order preparing</span></article></div></main></div>}
  {type === "admin" && <div class="mock-body admin-body"><aside><b>Saffron Group</b><span>Overview</span><span>Branches</span><span>Menus</span><span>Staff</span><span>Promos</span></aside><main><p class="mini-eyebrow">Across your group</p><h3>Service today</h3><div class="metrics"><article><small>ORDERS</small><b>184</b><span>All branches</span></article><article><small>SALES</small><b>₹86,420</b><span>Recorded today</span></article><article><small>AVG. SERVICE</small><b>24 min</b><span>Confirm to served</span></article></div><div class="chart"><span style="--h:42%"></span><span style="--h:68%"></span><span style="--h:54%"></span><span style="--h:82%"></span><span style="--h:74%"></span><span style="--h:92%"></span><span style="--h:70%"></span></div></main></div>}
  {type === "collateral" && <div class="mock-body collateral-body"><div class="controls"><small>COLLATERAL STUDIO</small><h3>Table cards</h3><label>Format <span>A6 standing card</span></label><label>Theme <span>Serene</span></label><label>Table <span>Table 06</span></label><button>Export print-ready PDF</button></div><div class="paper"><span>Saffron House</span><div class="fake-qr"></div><h3>Your table, together.</h3><p>Scan to browse and order</p><small>TABLE 06</small></div></div>}
</div>

<style>
  .feature-mockup{overflow:hidden;border:1px solid var(--line-1);border-radius:24px;background:#fff;box-shadow:var(--shadow-2);font-size:12px}.mock-top{height:48px;display:flex;align-items:center;justify-content:space-between;padding:0 18px;border-bottom:1px solid var(--line-1);color:var(--ink-2);font-size:8px;letter-spacing:.08em}.mock-top span:last-child{display:flex;align-items:center;gap:6px}.mock-top i{width:6px;height:6px;border-radius:50%;background:#3f7d54}.mock-body{min-height:360px;display:grid;grid-template-columns:130px 1fr}.mock-body aside{display:flex;flex-direction:column;gap:5px;padding:20px 14px;border-right:1px solid var(--line-1);background:var(--soft-white)}.mock-body aside b{margin-bottom:6px}.mock-body aside small{margin-bottom:14px;color:var(--gold)}.mock-body aside span{padding:7px 9px;border-radius:7px;color:var(--ink-2)}.mock-body aside span:first-of-type,.mock-body aside .active{background:var(--sunken);color:var(--ink)}.mock-body main{padding:24px}.mini-eyebrow{margin:0;color:var(--gold);font-size:8px;letter-spacing:.1em;text-transform:uppercase}.mock-body h3{margin:4px 0 18px;font-size:20px}.search{padding:9px 12px;border:1px solid var(--line-1);border-radius:8px;color:var(--ink-2)}.mock-food-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:12px}.mock-food-grid article{display:grid;grid-template-columns:52px 1fr;align-items:center;gap:8px;padding:9px;border:1px solid var(--line-1);border-radius:10px}.mock-food-grid i{grid-row:1/3;width:52px;height:52px;border-radius:8px;background:#d59a56}.mock-food-grid article:nth-child(2) i{background:#855331}.mock-food-grid b{font-size:10px}.mock-food-grid small{color:var(--ink-2)}.mock-cart{display:flex;justify-content:space-between;margin-top:14px;padding:12px;border-radius:10px;background:#010101;color:#fff;font-size:10px}
  .track-body{display:block;padding:30px}.track-body>h3{margin-bottom:0}.track-body>p{color:var(--ink-3)}.timeline{display:grid;grid-template-columns:repeat(4,1fr);margin-top:34px}.timeline article{position:relative;display:flex;flex-direction:column;gap:10px;padding-right:8px;border-top:2px solid var(--line-2)}.timeline i{width:12px;height:12px;margin-top:-7px;border:3px solid #fff;border-radius:50%;background:var(--ink-4);box-shadow:0 0 0 1px var(--line-2)}.timeline .done{border-color:var(--gold)}.timeline .done i{background:var(--gold)}.timeline .active{border-color:var(--gold)}.timeline .active i{background:#010101;box-shadow:0 0 0 4px rgba(115,91,37,.13)}.timeline span{display:flex;flex-direction:column}.timeline b{font-size:10px}.timeline small{color:var(--ink-3);font-size:8px}.assist-row{display:flex;gap:10px;margin-top:40px}.assist-row button{min-height:38px;padding:0 16px;border:1px solid var(--line-1);border-radius:999px;background:#fff;font-weight:600}
  .waiter,.waiter .mock-top{background:var(--ops);color:rgba(255,255,255,.9);border-color:rgba(255,255,255,.1)}.ops-body aside{background:oklch(0.13 .012 250);border-color:rgba(255,255,255,.08)}.ops-body aside span{color:rgba(255,255,255,.48)}.ops-body aside span.active{background:var(--ops-elevated-2);color:var(--ops-amber)}.ops-body main{background:var(--ops)}.ops-title{display:flex;justify-content:space-between;align-items:center}.ops-title small{color:var(--ops-amber);font-size:7px}.ops-title h3{margin:3px 0}.ops-title>b{padding:7px 10px;border:1px solid rgba(255,255,255,.1);border-radius:999px;color:rgba(255,255,255,.6);font-size:8px}.floor-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.floor-grid article{display:flex;min-height:100px;flex-direction:column;padding:13px;border:1px solid rgba(255,255,255,.09);border-top:2px solid var(--ops-amber);border-radius:9px;background:var(--ops-elevated)}.floor-grid article.ready{border-top-color:#68ad78}.floor-grid article.quiet{border-top-color:#75808a}.floor-grid small{color:rgba(255,255,255,.42);font:7px "JetBrains Mono",monospace}.floor-grid b{margin-top:9px}.floor-grid span{color:rgba(255,255,255,.48);font-size:9px}
  .admin-body main{background:var(--soft-white)}.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.metrics article{display:flex;flex-direction:column;padding:12px;border:1px solid var(--line-1);border-radius:9px;background:#fff}.metrics small{color:var(--gold);font:7px "JetBrains Mono",monospace}.metrics b{font:500 16px "JetBrains Mono",monospace}.metrics span{color:var(--ink-3);font-size:8px}.chart{height:125px;display:flex;align-items:flex-end;gap:8px;margin-top:18px;padding:15px;border:1px solid var(--line-1);border-radius:10px;background:#fff}.chart span{flex:1;height:var(--h);border-radius:3px 3px 0 0;background:rgba(115,91,37,.45)}
  .collateral-body{grid-template-columns:200px 1fr;align-items:center;padding:24px;background:#eae5d9}.controls{display:flex;flex-direction:column;padding-right:24px}.controls small{color:var(--gold);font:7px "JetBrains Mono",monospace}.controls h3{margin:4px 0 18px}.controls label{display:flex;justify-content:space-between;padding:9px 0;border-bottom:1px solid rgba(27,28,26,.1);color:var(--ink-3);font-size:9px}.controls label span{color:var(--ink);font-weight:600}.controls button{margin-top:18px;min-height:36px;border:0;border-radius:999px;background:#010101;color:#fff;font-size:9px;font-weight:600}.paper{width:190px;height:300px;justify-self:center;display:flex;flex-direction:column;align-items:center;padding:26px 20px;border-radius:4px;background:#faf9f5;box-shadow:0 18px 40px rgba(27,28,26,.18);transform:rotate(1deg)}.paper>span{font-weight:650}.paper .fake-qr{width:100px;height:100px;margin:28px 0 20px;background:repeating-conic-gradient(#1b1c1a 0 25%,transparent 0 50%) 0/16px 16px}.paper h3{margin:0;font-size:14px}.paper p{color:var(--ink-3);font-size:9px}.paper>small{margin-top:auto;color:var(--gold);font:8px "JetBrains Mono",monospace}
  @media(max-width:639px){.feature-mockup{border-radius:16px}.mock-body{min-height:300px;grid-template-columns:85px 1fr}.mock-body aside{padding:14px 8px}.mock-body aside span{padding:6px 4px;font-size:8px}.mock-body main{padding:18px}.mock-food-grid{grid-template-columns:1fr}.mock-food-grid article:nth-child(2){display:none}.timeline{grid-template-columns:1fr}.timeline article{min-height:55px;padding:0 0 0 22px;border-top:0;border-left:2px solid var(--line-2)}.timeline i{position:absolute;left:-7px;top:4px;margin:0}.assist-row{margin-top:20px}.floor-grid{grid-template-columns:1fr}.floor-grid article:nth-child(n+3){display:none}.metrics{grid-template-columns:1fr 1fr}.metrics article:nth-child(3){display:none}.collateral-body{grid-template-columns:1fr;padding:20px}.controls{display:none}.paper{width:170px;height:260px}.paper .fake-qr{width:84px;height:84px}}
</style>
