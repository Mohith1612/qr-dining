---
import Wordmark from "./Wordmark.astro";
const path = Astro.url.pathname;
---
<header class="site-header" data-header>
  <div class="container header-inner">
    <Wordmark />
    <nav class="desktop-nav" aria-label="Primary navigation">
      <a class:list={{ active: path.startsWith("/product") }} href="/product">Product</a>
      <a class:list={{ active: path.startsWith("/pricing") }} href="/pricing">Pricing</a>
    </nav>
    <div class="header-actions">
      <a class="button button-primary desktop-demo" href="/demo">Request a demo</a>
      <a class="button button-primary mobile-demo" href="/demo">Demo</a>
      <button class="menu-button" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" data-menu-button>
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<div id="mobile-menu" class="mobile-sheet" aria-hidden="true" data-mobile-menu>
  <div class="sheet-head container"><Wordmark /><button class="close-button" type="button" aria-label="Close menu" data-menu-close>Close</button></div>
  <nav class="sheet-links container" aria-label="Mobile navigation">
    <a href="/product">Product <span>01</span></a>
    <a href="/pricing">Pricing <span>02</span></a>
    <a href="/demo">Request a demo <span>03</span></a>
  </nav>
  <a class="sheet-email container" href="mailto:hello@qrdining.app">hello@qrdining.app</a>
</div>

<script>
  const header = document.querySelector("[data-header]");
  const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
  const openButton = document.querySelector<HTMLButtonElement>("[data-menu-button]");
  const closeButton = document.querySelector<HTMLButtonElement>("[data-menu-close]");
  let priorFocus: HTMLElement | null = null;

  const updateHeader = () => header?.classList.toggle("scrolled", window.scrollY > 24);
  updateHeader();
  window.addEventListener("scroll", updateHeader, { passive: true });

  const close = () => {
    menu?.classList.remove("open");
    menu?.setAttribute("aria-hidden", "true");
    openButton?.setAttribute("aria-expanded", "false");
    document.body.classList.remove("menu-open");
    document.querySelector("main")?.removeAttribute("inert");
    document.querySelector("footer")?.removeAttribute("inert");
    header?.removeAttribute("inert");
    priorFocus?.focus();
  };
  const open = () => {
    priorFocus = document.activeElement as HTMLElement;
    menu?.classList.add("open");
    menu?.setAttribute("aria-hidden", "false");
    openButton?.setAttribute("aria-expanded", "true");
    document.body.classList.add("menu-open");
    document.querySelector("main")?.setAttribute("inert", "");
    document.querySelector("footer")?.setAttribute("inert", "");
    header?.setAttribute("inert", "");
    closeButton?.focus();
  };
  openButton?.addEventListener("click", open);
  closeButton?.addEventListener("click", close);
  menu?.querySelectorAll("a").forEach(link => link.addEventListener("click", close));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menu?.classList.contains("open")) close();
    if (event.key === "Tab" && menu?.classList.contains("open")) {
      const focusable = [...menu.querySelectorAll<HTMLElement>("a,button")];
      const first = focusable[0]; const last = focusable.at(-1);
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
      else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
    }
  });
</script>

<style>
  .site-header { position:sticky; top:0; z-index:50; height:64px; background:rgba(250,249,245,0); border-bottom:1px solid transparent; transition:background 200ms,border-color 200ms,backdrop-filter 200ms; }
  .site-header.scrolled { background:rgba(250,249,245,.8); border-bottom-color:var(--line-1); backdrop-filter:blur(20px); }
  .header-inner { height:64px; display:grid; grid-template-columns:1fr auto 1fr; align-items:center; }
  .header-inner > :first-child { justify-self:start; }
  .desktop-nav { display:flex; align-items:center; gap:32px; }
  .desktop-nav a { color:var(--ink-2); font-size:15px; font-weight:550; text-decoration:none; }
  .desktop-nav a:hover,.desktop-nav a.active { color:var(--ink); }
  .header-actions { display:flex; justify-content:flex-end; align-items:center; gap:8px; }
  .header-actions .button { min-height:40px; padding-inline:19px; font-size:14px; }
  .mobile-demo,.menu-button { display:none; }
  .mobile-sheet { display:none; }
  @media(max-width:639px) {
    .header-inner { grid-template-columns:1fr auto; }
    .desktop-nav,.desktop-demo { display:none; }
    .mobile-demo,.menu-button { display:inline-flex; }
    .menu-button { width:44px; height:44px; border:0; background:transparent; border-radius:999px; align-items:center; justify-content:center; flex-direction:column; gap:5px; cursor:pointer; }
    .menu-button span { width:18px; height:1.5px; background:var(--ink); }
    .mobile-sheet { position:fixed; display:flex; visibility:hidden; opacity:0; transform:translateY(-12px); inset:0; z-index:60; flex-direction:column; background:var(--canvas); transition:opacity 220ms var(--ease-out),transform 220ms var(--ease-out),visibility 220ms; }
    .mobile-sheet.open { visibility:visible; opacity:1; transform:none; }
    .sheet-head { height:72px; display:flex; align-items:center; justify-content:space-between; }
    .close-button { min-width:64px; min-height:44px; border:0; background:transparent; color:var(--ink-2); cursor:pointer; }
    .sheet-links { display:flex; flex:1; flex-direction:column; justify-content:center; padding-bottom:40px; }
    .sheet-links a { min-height:78px; display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid var(--line-1); font-size:30px; font-weight:600; letter-spacing:-.025em; text-decoration:none; }
    .sheet-links span { color:var(--gold); font:11px "JetBrains Mono",monospace; }
    .sheet-email { display:block; padding-bottom:32px; color:var(--ink-2); font-size:14px; text-decoration:none; }
  }
</style>
