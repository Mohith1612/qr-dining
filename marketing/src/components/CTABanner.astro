---
const {
  heading = "See it running on a real table.",
  copy = "We're onboarding early restaurants now. Request a demo and we'll walk you through a live table — your menu, your branding.",
} = Astro.props;
---
<section class="cta-section">
  <div class="container cta-inner reveal">
    <p class="eyebrow">Early access</p>
    <h2>{heading}</h2>
    <p class="cta-copy">{copy}</p>
    <div class="cta-actions"><a class="button button-primary" href="/demo">Request a demo</a><span>or write to <a href="mailto:hello@qrdining.app">hello@qrdining.app</a></span></div>
    <p class="word-rhythm mono">Realtime <i>·</i> Collaborative <i>·</i> Cardless</p>
  </div>
</section>

<style>
  .cta-section { padding-block:112px; background:var(--sunken); }
  .cta-inner { position:relative; overflow:hidden; padding:72px; border:1px solid var(--line-1); border-radius:24px; background:var(--glow-warm),rgba(250,249,245,.72); text-align:center; }
  h2 { margin-bottom:16px; }
  .cta-copy { max-width:650px; margin:0 auto 28px; color:var(--ink-2); font-size:18px; }
  .cta-actions { display:flex; align-items:center; justify-content:center; gap:18px; color:var(--ink-3); font-size:14px; }
  .cta-actions span a { color:var(--ink); text-underline-offset:3px; }
  .word-rhythm { margin:48px 0 0; color:var(--ink-3); font-size:10px; letter-spacing:.14em; text-transform:uppercase; }
  .word-rhythm i { padding-inline:8px; color:var(--gold); font-style:normal; }
  @media(max-width:639px) {
    .cta-section { padding-block:64px; }
    .cta-inner { padding:48px 20px; }
    .cta-actions { flex-direction:column; }
    .cta-actions .button { width:100%; max-width:280px; }
  }
</style>
