---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProductVisuals from "../components/ProductVisuals.astro";
import PricingCard from "../components/PricingCard.astro";
import CTABanner from "../components/CTABanner.astro";
import { plans } from "../data/site";
import { Building2, ChartNoAxesCombined, CircleDollarSign, Gift, PanelsTopLeft, ReceiptIndianRupee } from "@lucide/astro";

const title = "QR Dining — The operating system for dine-in restaurants";
const description = "One QR per table: guests order together from their phones while your kitchen, waiters, and managers run the service on live boards. Built for India — UPI, GST, ₹. Request a demo.";
const appSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "QR Dining",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  offers: plans.map(plan => ({ "@type": "Offer", priceCurrency: "INR", price: plan.price, name: plan.name })),
};
const roles = [
  ["Waiters", "Floor board: which tables need attention, what's ready to serve, assistance calls, cash and card settlement."],
  ["Kitchen", "A display built for the pass: confirmed → preparing → ready, with every modifier spelled out."],
  ["Managers", "The whole floor plus menus, tables, promos, and day-to-day admin."],
  ["Owners", "Everything, everywhere: staff, plans, branding, and performance across every branch."],
];
const features = [
  [Building2, "Multi-branch", "One dashboard across locations, with per-branch menus and staff."],
  [PanelsTopLeft, "Menu & modifiers", "Choices, availability, and specials — live everywhere instantly."],
  [ChartNoAxesCombined, "Analytics", "Service performance and sales, by branch and across the group."],
  [Gift, "Loyalty & promos", "Points on every bill, verified redemption, and promo codes at payment."],
  [ReceiptIndianRupee, "QR collateral studio", "Print-ready table cards, tents, and stickers in your branding."],
  [CircleDollarSign, "Billing that adds up", "GST-aware bills, discounts, tips, and recorded split payments."],
];
---
<BaseLayout title={title} description={description} schema={appSchema}>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy hero-enter">
        <p class="eyebrow" style="--i:0">Hospitality, in your hand</p>
        <h1 style="--i:1">The operating system for dine-in.</h1>
        <p class="hero-lede" style="--i:2">One QR on the table. The whole table browses, orders, and pays together — and your kitchen, waiters, and managers run the service from live boards built for each of them.</p>
        <div class="hero-actions" style="--i:3"><a class="button button-primary" href="/demo">Request a demo</a><a class="button button-ghost" href="#how-it-works">See how it works</a></div>
        <p class="hero-micro" style="--i:4">Free plan available <i>·</i> No app for guests to install</p>
      </div>
      <div class="hero-visual-enter"><ProductVisuals variant="hero" /></div>
    </div>
  </section>

  <section class="section reframe-section">
    <div class="container reframe reveal">
      <div><p class="eyebrow">Not another QR menu</p><h2>A QR menu is a page. This is your operation.</h2><p class="lede">Most QR products stop at showing the menu on one phone. QR Dining starts there — then runs the order through your kitchen, your floor, your bill, and your books.</p></div>
      <div class="compare">
        <article><h3>A QR menu</h3><p>Shows the menu</p><p>One phone per table</p><p>Order goes to a printer</p></article>
        <article><h3>QR Dining</h3><p>Whole table in one session</p><p>Live kitchen & waiter boards</p><p>Bill, split payments, records</p></article>
      </div>
    </div>
  </section>

  <section id="how-it-works" class="section section-sunken">
    <div class="container">
      <div class="section-heading reveal"><p class="eyebrow">One service, start to finish</p><h2>From scan to served.</h2></div>
      <div class="steps stagger">
        <article class="step-card card reveal" style="--i:0"><span class="mono">01</span><ProductVisuals variant="flow-qr" /><h3>Scan & join</h3><p>Guests scan the table card. Everyone joins the same session from their own phone — no app, no signup.</p></article>
        <article class="step-card card reveal" style="--i:1"><span class="mono">02</span><ProductVisuals variant="flow-cart" /><h3>Order together</h3><p>A shared live cart the whole table can see. One host confirms, so the kitchen gets one clean order.</p></article>
        <article class="step-card card reveal" style="--i:2"><span class="mono">03</span><ProductVisuals variant="flow-kitchen" /><h3>Run the service</h3><p>Kitchen and waiter boards update in realtime: preparing, ready, served. The bill, split payments, and records follow.</p></article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container session-grid">
      <div class="session-copy reveal">
        <p class="eyebrow">The table session</p>
        <h2>Built around the table, not the phone.</h2>
        <p class="lede">Every table gets one live session. Friends join with a name, see each other in the cart, and order as a group — the host keeps it orderly, and hosting can be handed over mid-meal.</p>
        <ul><li>Shared live cart with presence</li><li>One host places the order — handover anytime</li><li>Call a waiter or ask for the bill from the phone</li><li>Sessions recover — a table is never stranded</li></ul>
        <a class="text-link" href="/product#guests">Explore the guest experience →</a>
      </div>
      <div class="session-art reveal">
        <ProductVisuals variant="session" />
        <div class="event-chip first"><i></i><span><b>Priya joined the table</b><small>Just now</small></span></div>
        <div class="event-chip second"><i></i><span><b>Order confirmed · Kitchen</b><small>Table 06</small></span></div>
        <div class="event-chip third"><i></i><span><b>Bill requested</b><small>Waiter notified</small></span></div>
      </div>
    </div>
  </section>

  <section class="section section-dark">
    <div class="container">
      <div class="section-heading reveal"><p class="eyebrow">For your team</p><h2>Every role gets its own screen.</h2><p class="lede">Staff sign in with a PIN. No training manuals — each board shows only what that person needs, live.</p></div>
      <div class="role-grid stagger">
        {roles.map(([name, copy], index) => <article class="role-card reveal" style={`--i:${index}`}><span class="mono">0{index + 1}</span><div class="role-ui"><i></i><i></i><i></i></div><h3>{name}</h3><p>{copy}</p></article>)}
      </div>
      <a class="text-link staff-link" href="/product#staff">See the staff console →</a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading reveal"><p class="eyebrow">One connected system</p><h2>The parts you'd otherwise duct-tape together.</h2></div>
      <div class="feature-grid stagger">
        {features.map(([Icon, name, copy], index) => <article class="feature-tile card reveal" style={`--i:${index}`}><Icon size={22} stroke-width={1.5}/><div><h3>{name}</h3><p>{copy}</p></div></article>)}
      </div>
      <a class="text-link feature-link" href="/product">Everything in the product →</a>
    </div>
  </section>

  <section class="india-band">
    <div class="container india-inner reveal"><div><p class="eyebrow">Built for India</p><h2>Made for how India dines and pays.</h2><p>UPI, cash, or card at the table — settled by your staff, recorded properly. GST on the bill. ₹ everywhere. Works on any phone in the browser, on restaurant Wi-Fi or patchy 4G.</p></div><div class="fact-chips"><span>UPI · Cash · Card</span><span>GST-aware billing</span><span>₹ native</span><span>No app install</span></div></div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading reveal"><p class="eyebrow">Engineering you can trust</p><h2>Boring, in the ways that matter.</h2><p class="lede">Restaurant software has one job on a busy night: keep working. QR Dining is built like infrastructure — every order and payment is recorded in an audit trail, sessions survive dropped connections, and the system degrades gracefully instead of failing loudly.</p></div>
      <div class="trust-grid stagger">
        <article class="reveal" style="--i:0"><span class="mono">RECONNECT</span><h3>Realtime that rejoins</h3><p>Phones rejoin mid-service with nothing lost.</p></article>
        <article class="reveal" style="--i:1"><span class="mono">AUDIT TRAIL</span><h3>A record of every change</h3><p>Every order, payment, and change is recorded.</p></article>
        <article class="reveal" style="--i:2"><span class="mono">OPERATIONS</span><h3>Prepared for the bad nights</h3><p>Nightly backups, monitored around the clock.</p></article>
      </div>
    </div>
  </section>

  <section class="section section-sunken">
    <div class="container">
      <div class="section-heading pricing-heading reveal"><p class="eyebrow">Transparent pricing</p><h2>Start free. Grow when you do.</h2></div>
      <div class="pricing-grid stagger">{[plans[1],plans[0],plans[2]].map((plan,index) => <div class={`price-shell price-${index}`}><PricingCard plan={plan} compact={true} /></div>)}</div>
      <div class="pricing-link"><a class="text-link" href="/pricing">See full pricing →</a></div>
    </div>
  </section>

  <CTABanner copy="We're onboarding early restaurants now. Request a demo and we'll walk you through a live table — your menu, your branding — and set you up ourselves if it fits." />
</BaseLayout>

<style>
  .hero { min-height:calc(100svh - 64px); display:grid; align-items:center; padding:72px 0 56px; background:var(--glow-warm); overflow:hidden; }
  .hero-grid { display:grid; grid-template-columns:52% 48%; align-items:center; }
  .hero-copy { position:relative; z-index:5; max-width:625px; }
  .hero-copy h1 { max-width:620px; margin-bottom:24px; }
  .hero-lede { max-width:590px; margin-bottom:30px; color:var(--ink-2); font-size:18px; line-height:1.6; }
  .hero-actions { display:flex; gap:10px; }
  .hero-micro { margin:16px 0 0; color:var(--ink-3); font-size:13px; }
  .hero-micro i { padding-inline:6px; color:var(--gold); font-style:normal; }
  .reframe { display:grid; grid-template-columns:1.05fr .95fr; gap:88px; align-items:end; }
  .reframe h2 { margin-bottom:20px; }
  .compare { display:grid; grid-template-columns:1fr 1fr; border:1px solid var(--line-1); border-radius:16px; background:rgba(255,255,255,.55); }
  .compare article { padding:28px; }
  .compare article+article { border-left:1px solid var(--line-1); background:#fff; border-radius:0 16px 16px 0; }
  .compare h3 { margin-bottom:22px; font-size:17px; }
  .compare article:last-child h3 { color:var(--gold); }
  .compare p { margin:0; padding:10px 0; border-top:1px solid var(--line-1); color:var(--ink-2); font-size:14px; }
  .steps { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; }
  .step-card { padding:18px 18px 26px; }
  .step-card>span { display:block; margin:6px 4px 14px; color:var(--gold); font-size:10px; }
  .step-card h3 { margin:24px 6px 9px; }
  .step-card>p { margin:0 6px; color:var(--ink-2); font-size:14px; }
  .session-grid { display:grid; grid-template-columns:.88fr 1.12fr; gap:88px; align-items:center; }
  .session-copy h2 { margin-bottom:20px; }
  .session-copy ul { padding:0; margin:28px 0; list-style:none; }
  .session-copy li { position:relative; padding:8px 0 8px 24px; color:var(--ink-2); font-size:15px; }
  .session-copy li:before { content:""; position:absolute; left:0; top:18px; width:8px; height:1px; background:var(--gold); }
  .session-art { position:relative; }
  .event-chip { position:absolute; display:flex; align-items:center; gap:10px; min-width:190px; padding:11px 14px; border:1px solid var(--line-1); border-radius:12px; background:rgba(255,255,255,.94); box-shadow:var(--shadow-2); backdrop-filter:blur(12px); }
  .event-chip i { width:7px;height:7px;border-radius:50%;background:var(--ok,#3f7d54)}.event-chip span{display:flex;flex-direction:column}.event-chip b{font-size:10px}.event-chip small{color:var(--ink-3);font-size:8px}
  .event-chip.first{top:-22px;right:24px}.event-chip.second{right:-36px;top:46%}.event-chip.third{left:-34px;bottom:-22px}
  .role-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.role-card{padding:22px;border:1px solid rgba(255,255,255,.1);border-radius:14px;background:var(--ops-elevated);box-shadow:0 10px 30px -10px rgba(0,0,0,.55)}.role-card>span{color:var(--ops-amber);font-size:9px}.role-card h3{margin:20px 0 10px}.role-card p{margin:0;color:rgba(255,255,255,.6);font-size:13px}.role-ui{height:76px;display:flex;align-items:flex-end;gap:5px;margin-top:22px;padding:12px;border-radius:9px;background:var(--ops-elevated-2)}.role-ui i{width:31%;height:68%;border-radius:4px;background:rgba(255,255,255,.08)}.role-ui i:nth-child(2){height:100%;border-top:2px solid var(--ops-amber)}.role-ui i:nth-child(3){height:42%;border-top:2px solid #68ad78}.staff-link{margin-top:34px}
  .feature-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.feature-tile{display:flex;gap:18px;padding:26px}.feature-tile svg{flex:0 0 auto;color:var(--gold)}.feature-tile h3{margin-bottom:7px;font-size:18px}.feature-tile p{margin:0;color:var(--ink-2);font-size:13px}.feature-link{margin-top:34px}
  .india-band{padding:60px 0;background:var(--sunken);border-block:1px solid var(--line-1)}.india-inner{display:grid;grid-template-columns:1.2fr .8fr;gap:80px;align-items:center}.india-inner h2{margin-bottom:14px}.india-inner p:last-child{margin:0;color:var(--ink-2)}.fact-chips{display:grid;grid-template-columns:1fr 1fr;gap:10px}.fact-chips span{min-height:48px;display:flex;align-items:center;padding:0 15px;border:1px solid var(--line-1);border-radius:12px;background:rgba(255,255,255,.65);font-size:13px;font-weight:600}
  .trust-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border-top:1px solid var(--line-1)}.trust-grid article{padding:32px 32px 0 0}.trust-grid article+article{padding-left:32px;border-left:1px solid var(--line-1)}.trust-grid span{color:var(--gold);font-size:9px;letter-spacing:.1em}.trust-grid h3{margin:16px 0 8px}.trust-grid p{margin:0;color:var(--ink-2);font-size:14px}
  .pricing-heading{text-align:center;margin-inline:auto}.pricing-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.price-0{order:2}.price-1{order:1}.price-2{order:3}.pricing-link{text-align:center;margin-top:34px}
  @media(max-width:1023px){
    .hero{padding-top:56px}.hero-grid{grid-template-columns:50% 50%}.reframe{gap:48px}.session-grid{gap:48px}.role-grid{grid-template-columns:1fr 1fr}.feature-grid{grid-template-columns:1fr 1fr}.event-chip.second{right:-10px}
  }
  @media(max-width:639px){
    .hero{min-height:auto;padding:56px 0 32px}.hero-grid{grid-template-columns:1fr}.hero-copy{text-align:left}.hero-lede{font-size:17px}.hero-actions{display:grid;grid-template-columns:1fr 1fr}.hero-actions .button{padding-inline:14px}.hero-micro{text-align:center}.hero-visual-enter{margin-top:42px}
    .reframe,.session-grid,.india-inner{grid-template-columns:1fr;gap:40px}.compare{grid-template-columns:1fr}.compare article+article{border-left:0;border-top:1px solid var(--line-1);border-radius:0 0 16px 16px}.compare article{padding:24px}
    .steps{grid-template-columns:1fr}.step-card{display:grid;grid-template-columns:35px 1fr;column-gap:14px}.step-card>span{grid-row:1/4;position:relative}.step-card>span:after{content:"";position:absolute;top:26px;bottom:0;left:7px;width:1px;background:var(--line-1)}.step-card :global(.mini-vignette){grid-column:2}.step-card h3{grid-column:2;margin-top:20px}.step-card>p{grid-column:2}
    .event-chip{position:static;margin-top:10px}.event-chip.third{display:none}.event-chip.first,.event-chip.second{display:inline-flex;margin-right:6px}.role-grid,.feature-grid,.pricing-grid{grid-template-columns:1fr}.feature-tile{padding:20px}.fact-chips{grid-template-columns:1fr 1fr}.trust-grid{grid-template-columns:1fr;border-top:0}.trust-grid article,.trust-grid article+article{padding:28px 0;border-left:0;border-top:1px solid var(--line-1)}.price-0{order:1}.price-1{order:2}
  }
</style>
